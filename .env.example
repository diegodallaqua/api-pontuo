# Modelo das variáveis de ambiente da aplicação.
# Copie este arquivo para .env e preencha com os valores reais.
# O .env não é versionado: nunca coloque credenciais reais aqui.

# Credenciais de acesso ao banco de dados MariaDB
DB_USERNAME=
DB_PASSWORD=

# Segredo usado para assinar os tokens JWT (HS256).
# Mínimo de 32 caracteres; a aplicação não sobe sem esta variável.
# Gere um valor aleatório novo por ambiente:
#
#   PowerShell:
#     $bytes = New-Object byte[] 48
#     [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes)
#     [Convert]::ToBase64String($bytes)
#
#   Bash:
#     openssl rand -base64 48
JWT_SECRET=
