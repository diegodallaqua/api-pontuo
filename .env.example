# PONTUO API - VARIAVEIS DE AMBIENTE
#
# Copie este arquivo para .env e preencha
# com os valores reais.
#
# O arquivo .env nao deve ser versionado.
# Nunca coloque senhas reais neste modelo.


# 1. PERFIL DO SPRING BOOT
#
# dev  = desenvolvimento local
# prod = producao (Render + MariaDB Cloud)
#
# O perfil padrao e dev.

SPRING_PROFILES_ACTIVE=dev


# 2. BANCO DE DADOS - MARIADB
#
# Desenvolvimento:
# Host: localhost
# Porta: 3306
# Banco: db_pontuo
#
# Producao:
# Host e porta fornecidos pelo MariaDB Cloud
# Banco: pontuo
#
# DB_HOST, DB_PORT e DB_NAME sao utilizados
# apenas pelo perfil prod.

DB_USERNAME=
DB_PASSWORD=

# Configuracoes de producao
# DB_HOST=
# DB_PORT=4000
# DB_NAME=pontuo


# 3. SEGURANCA - JWT
#
# Segredo utilizado para assinar tokens JWT.
# Gere um segredo aleatorio e exclusivo
# para cada ambiente.
#
# PowerShell:
# $bytes = New-Object byte[] 48
# [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes)
# [Convert]::ToBase64String($bytes)
#
# Bash:
# openssl rand -base64 48

JWT_SECRET=


# 4. CORS - FRONTEND
#
# Desenvolvimento:
# Sem configurar esta variavel, o backend
# aceita localhost e 127.0.0.1 em qualquer
# porta, conforme application-dev.properties.
#
# Producao:
# Informe o dominio HTTPS da Vercel.
#
# Exemplo:
# CORS_ALLOWED_ORIGINS=https://pontuo.vercel.app

# CORS_ALLOWED_ORIGINS=


# 5. SERVIDOR HTTP
#
# Desenvolvimento: porta 8080.
# Producao: a Render fornece PORT.
#
# Nao e necessario definir localmente.

# PORT=8080
